# Copy to .env and fill in.

# --- Gmail (sending) ---
# Google Account -> Security -> 2-Step Verification ON -> App passwords -> create one for "Mail".
GMAIL_ADDRESS=sandeep22112002@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Telegram (approval notifications) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token.
# 2. Send any message to your new bot, then run:  python main.py --whoami   (prints your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (reads search results, writes the emails) ---
# Option A: Azure OpenAI (Azure AI Foundry -> deploy a model such as gpt-4o-mini)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Option B: any OpenAI-compatible API (used when AZURE_OPENAI_ENDPOINT is empty), e.g. Groq (free):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Web search (optional) ---
# Empty = free DuckDuckGo search. A Tavily key (tavily.com, 1000 free searches/month) gives better results.
TAVILY_API_KEY=
